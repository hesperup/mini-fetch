#!/bin/sh
# mini-fetch — a tiny, dependency-light system fetch (neofetch/fastfetch style)
# Copyright (c) 2024 mini-fetch contributors — MIT License
#
# Designed to run on systems without awk/bc/perl: uses only POSIX sh and
# stock system utilities. Primary target: legacy iOS devices (iPhone OS 10.x)
# but falls back gracefully on Linux/BSD/macOS.
#
# Usage: fetch [--no-color] [--no-bar] [--version] [--help]

VERSION="0.1.0"

# ---------------------------------------------------------------------------
# Options
# ---------------------------------------------------------------------------
use_color=1
use_bar=1
use_logo=""   # empty = auto (on for wide interactive terminals)

for arg in "$@"; do
    case $arg in
        --no-color) use_color=0 ;;
        --no-bar)   use_bar=0 ;;
        --logo)     use_logo=1 ;;
        --no-logo)  use_logo=0 ;;
        -h|--help)
            cat <<EOF
mini-fetch $VERSION — tiny system info fetch

Usage: fetch [options]

Options:
  --no-color   Disable ANSI colors
  --no-bar     Disable progress bars
  --logo       Show the side logo
  --no-logo    Hide the side logo
  -h, --help   Show this help
  -v, --version  Show version
EOF
            exit 0 ;;
        -v|--version) printf 'mini-fetch %s\n' "$VERSION"; exit 0 ;;
    esac
done

if [ "$use_color" = 1 ] && [ -t 1 ]; then
    E=$(printf '\033')
else
    E=
fi
RESET="${E}[0m"
BOLD="${E}[1m"
C_TITLE1="${E}[1;32m"   # user
C_TITLE2="${E}[1;36m"   # @host
C_KEY="${E}[1;36m"      # field names
C_BAR="${E}[1;32m"      # bar fill
C_BAR_EMPTY="${E}[0;90m" # bar track
C_DIM="${E}[0;90m"
C_LOGO="${E}[1;32m"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
has() { command -v "$1" >/dev/null 2>&1; }

# integer division with one decimal place, without bc/awk
idiv1() { printf '%d.%d' $(( $1 / $2 )) $(( ($1 % $2) * 10 / $2 )); }

# Normalise a device node to its whole-disk base (best effort, no /sys needed).
#   /dev/disk0s1s2 -> /dev/disk0   /dev/sda2 -> /dev/sda
#   /dev/mmcblk1p26 -> /dev/mmcblk1   /dev/nvme0n1p2 -> /dev/nvme0n1
disk_base() {
    printf '%s' "$1" | sed \
        -e 's#^\(/dev/disk[0-9][0-9]*\)s[0-9][0-9]*s[0-9][0-9]*$#\1#' \
        -e 's#^\(/dev/disk[0-9][0-9]*\)s[0-9][0-9]*$#\1#' \
        -e 's#^\(/dev/mmcblk[0-9][0-9]*\)p[0-9][0-9]*$#\1#' \
        -e 's#^\(/dev/nvme[0-9][0-9]*n[0-9][0-9]*\)p[0-9][0-9]*$#\1#' \
        -e 's#^\(/dev/loop[0-9][0-9]*\)p[0-9][0-9]*$#\1#' \
        -e 's#^\(/dev/[shvx]d[a-z][a-z]*\)[0-9][0-9]*$#\1#'
}

# field <name> <value>   — prints an aligned "Name      value" line
field() {
    printf '%s%-10s%s%s\n' "$C_KEY" "$1" "$RESET" "$2"
}

# bar <value> <max> [width] — prints a colored progress bar
bar() {
    _v=$1 _m=$2 _w=${3:-14}
    [ "$_m" -gt 0 ] 2>/dev/null || { printf ''; return; }
    _fill=$(( _v * _w / _m ))
    [ "$_fill" -lt 0 ] && _fill=0
    [ "$_fill" -gt "$_w" ] && _fill=$_w
    _i=0 _out=
    while [ "$_i" -lt "$_fill" ]; do
        _out="${_out}${C_BAR}█"
        _i=$(( _i + 1 ))
    done
    while [ "$_i" -lt "$_w" ]; do
        _out="${_out}${C_BAR_EMPTY}░"
        _i=$(( _i + 1 ))
    done
    printf '%s%s ' "$_out" "$RESET"
}

# ---------------------------------------------------------------------------
# OS / platform detection
# ---------------------------------------------------------------------------
os_name=$(sw_vers -productName 2>/dev/null)
os_ver=$(sw_vers -productVersion 2>/dev/null)
os_build=$(sw_vers -buildVersion 2>/dev/null)

kernel=$(uname -s)
if [ -n "$os_name" ]; then
    # Darwin with sw_vers: iOS or macOS
    case $os_name in
        "iPhone OS") platform=ios ;;
        *)           platform=macos ;;
    esac
elif [ "$kernel" = "Linux" ]; then
    platform=linux
    if [ -r /etc/os-release ]; then
        os_name=$(sed -n 's/^NAME=//p' /etc/os-release | tr -d '"' | head -n1)
        os_ver=$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"' | head -n1)
    fi
    [ -z "$os_name" ] && os_name=Linux
else
    platform=other
    os_name=$kernel
fi

machine=$(uname -n)
kernel_ver=$(uname -r)
arch=$(uname -m)
user=$(id -un 2>/dev/null || echo unknown)

