# ---------------------------------------------------------------------------
# Uptime
# ---------------------------------------------------------------------------
uptime_str=""
if [ -r /proc/uptime ]; then
    secs=$(cut -d' ' -f1 /proc/uptime | cut -d'.' -f1)
else
    boot=$(sysctl -n kern.boottime 2>/dev/null | sed -n 's/.*{ sec = \([0-9]*\).*/\1/p')
    now=$(date +%s 2>/dev/null)
    if [ -n "$boot" ] && [ -n "$now" ]; then
        secs=$(( now - boot ))
    fi
fi
if [ -n "$secs" ]; then
    days=$(( secs / 86400 ))
    hours=$(( (secs % 86400) / 3600 ))
    mins=$(( (secs % 3600) / 60 ))
    if [ "$days" -gt 0 ]; then
        uptime_str="${days}d ${hours}h ${mins}m"
    elif [ "$hours" -gt 0 ]; then
        uptime_str="${hours}h ${mins}m"
    else
        uptime_str="${mins}m"
    fi
fi

# ---------------------------------------------------------------------------
# Shell / terminal
# ---------------------------------------------------------------------------
shell=$(basename "${SHELL:-sh}" 2>/dev/null)
terminal=$(tty 2>/dev/null)
[ -z "$terminal" ] && terminal="(none)"

# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------
packages=""
if has dpkg; then
    n=$(dpkg -l 2>/dev/null | grep -c '^ii')
    [ "$n" -gt 0 ] && packages="$n (dpkg)"
elif has rpm; then
    n=$(rpm -qa 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && packages="$n (rpm)"
elif has apk; then
    n=$(apk info 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && packages="$n (apk)"
elif has pacman; then
    n=$(pacman -Q 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && packages="$n (pacman)"
elif has dnf; then
    n=$(dnf list installed 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && packages="$n (dnf)"
elif has brew; then
    n=$(ls -1 "$(brew --prefix)/Cellar" 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && packages="$n (brew)"
fi

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------
mem_total= mem_used=
case $platform in
    ios|macos)
        if has sysctl; then
            pagesize=$(sysctl -n hw.pagesize 2>/dev/null)
            memsize=$(sysctl -n hw.memsize 2>/dev/null)
            if [ -n "$pagesize" ] && [ -n "$memsize" ]; then
                mem_total=$(( memsize / 1024 / 1024 ))
                pages_app=0
                if has vm_stat; then
                    pa=$(sysctl -n vm.page_pageable_internal_count 2>/dev/null)
                    pp=$(sysctl -n vm.page_purgeable_count 2>/dev/null)
                    [ -n "$pa" ] && pages_app=$(( pa - pp ))
                    wired=$(vm_stat 2>/dev/null | sed -n 's/.*wired[^0-9]*\([0-9][0-9.]*\).*/\1/p')
                    comp=$(vm_stat 2>/dev/null | sed -n 's/.*occupied[^0-9]*\([0-9][0-9.]*\).*/\1/p')
                    wired=${wired%.}; [ -z "$wired" ] && wired=0
                    comp=${comp%.};  [ -z "$comp" ] && comp=0
                    mem_used=$(( (pages_app + wired + comp) * pagesize / 1024 / 1024 ))
                fi
            fi
        fi
        ;;
    linux)
        if [ -r /proc/meminfo ]; then
            mt=$(sed -n 's/^MemTotal:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
            ma=$(sed -n 's/^MemAvailable:[[:space:]]*\([0-9]*\).*/\1/p' /proc/meminfo)
            mem_total=$(( mt / 1024 ))
            [ -n "$ma" ] && mem_used=$(( (mt - ma) / 1024 ))
        fi
        ;;
esac

# ---------------------------------------------------------------------------
# Battery
# ---------------------------------------------------------------------------
battery= bat_pct=
case $platform in
    ios)
        if has ioreg; then
            iog=$(ioreg -w0 -l 2>/dev/null | grep -E '"CurrentCapacity"|"MaxCapacity"|"CycleCount"|"IsCharging"')
            cur=$(printf '%s\n' "$iog" | sed -n 's/.*"CurrentCapacity" = \([0-9]*\).*/\1/p' | head -n1)
            max=$(printf '%s\n' "$iog" | sed -n 's/.*"MaxCapacity" = \([0-9]*\).*/\1/p' | head -n1)
            cyc=$(printf '%s\n' "$iog" | sed -n 's/.*"CycleCount" = \([0-9]*\).*/\1/p' | head -n1)
            chg=$(printf '%s\n' "$iog" | sed -n 's/.*"IsCharging" = \(.*\)/\1/p' | head -n1)
            if [ -n "$cur" ] && [ -n "$max" ] && [ "$max" -gt 0 ] 2>/dev/null; then
                bat_pct=$(( cur * 100 / max ))
                battery="${bat_pct}%"
                [ -n "$cyc" ] && battery="$battery (${cyc} cycles)"
                [ "$chg" = "Yes" ] && battery="$battery [charging]"
            fi
        fi
        ;;
    linux)
        # Any battery-type supply; node names vary (BAT0, bq27426-0, max170xx...).
        for b in /sys/class/power_supply/*; do
            [ -r "$b/capacity" ] || continue
            _typ=$(cat "$b/type" 2>/dev/null)
            [ -z "$_typ" ] || [ "$_typ" = "Battery" ] || continue
            bat_pct=$(cat "$b/capacity" 2>/dev/null)
            [ -n "$bat_pct" ] || continue
            _st=$(cat "$b/status" 2>/dev/null)
            battery="${bat_pct}%"
            [ -n "$_st" ] && battery="$battery [${_st}]"
            break
        done
        ;;
    macos)
        if has pmset; then
            battery=$(pmset -g batt 2>/dev/null | sed -n 's/.*[[:space:]]\([0-9]*%\).*/\1/p' | head -n1)
            bat_pct=${battery%\%}
        fi
        ;;
esac

# ---------------------------------------------------------------------------
# Disk — whole *physical* disks, not just mounted filesystems
# ---------------------------------------------------------------------------
disk=
d_pct=
dftmp= lstmp=
if has mktemp; then
    dftmp=$(mktemp "${TMPDIR:-/tmp}/minifetch.df.XXXXXX")
    lstmp=$(mktemp "${TMPDIR:-/tmp}/minifetch.ls.XXXXXX")
fi

_rows=""
if [ -n "$dftmp" ]; then
    # Real, device-backed filesystems only. Plain `df -kP` (BusyBox has no -l);
    # drop pseudo/credential mounts under /run,/dev,/sys,/proc,/tmp.
    df -kP 2>/dev/null \
        | grep '^/dev/' \
        | grep -vE ' /(run|dev|sys|proc|tmp)(/| |$)' > "$dftmp"

    # De-duplicate the same device mounted more than once (bind mounts).
    _seen="" _lines=""
    while read -r _dev _tot _used _avail _cap _mnt; do
        [ -n "$_dev" ] || continue
        case "$_seen" in *"|$_dev|"*) continue ;; esac
        _seen="$_seen|$_dev|"
        _lines="$_lines$_dev $_tot $_used $_avail $_cap $_mnt
"
    done < "$dftmp"
    printf '%s' "$_lines" > "$dftmp"

    # Physical disks (Linux): whole-device size, so unallocated space and LVM
    # volumes are all accounted for. mmcblk*boot0/1 and loop/ram/dm are skipped.
    _disks="" _ndisks=0
    if [ "$platform" = linux ] && has lsblk && lsblk -b -l -n -o NAME,SIZE,TYPE >/dev/null 2>&1; then
        lsblk -b -l -n -o NAME,SIZE,TYPE 2>/dev/null > "$lstmp"
        while read -r _name _size _type; do
            [ "$_type" = disk ] || continue
            case $_name in
                loop*|ram*|zram*|sr*|fd*|dm-*|md*|nbd*|rbd*) continue ;;
                *boot[0-9]) continue ;;
            esac
            _disks="$_disks$_name|$_size
"
        done < "$lstmp"
        _ndisks=$(printf '%s\n' "$_disks" | grep -c .)
    fi

    if [ "$_ndisks" -ge 1 ]; then
        # Attribute each filesystem's used KiB to the whole disk it lives on
        # (LVM volumes and loop images are resolved via lsblk/losetup).
        _umap=""
        while read -r _dev _tot _used _avail _cap _mnt; do
            [ -n "$_dev" ] || continue
            _dn=$(lsblk -s -l -n -o NAME "$_dev" 2>/dev/null | tail -n1)
            case $_dn in
                loop*)
                    _back=$(losetup -a 2>/dev/null | sed -n "s#^/dev/$_dn:.*(\(.*\))\$#\1#p" | head -n1)
                    [ -n "$_back" ] && _dn=$(lsblk -s -l -n -o NAME "$_back" 2>/dev/null | tail -n1)
                    ;;
            esac
            if [ "$_ndisks" = 1 ]; then
                _dn=$(printf '%s\n' "$_disks" | sed -n 's/|.*//p' | head -n1)
            fi
            _umap="$_umap$_dn|$_used
"
        done < "$dftmp"

        while IFS='|' read -r _name _size; do
            [ -n "$_name" ] || continue
            [ "$_size" -gt 0 ] 2>/dev/null || continue
            _u=0
            while IFS='|' read -r _mn _mu; do
                [ "$_mn" = "$_name" ] && _u=$(( _u + _mu ))
            done <<EOFU
$_umap
EOFU
            _pct=$(( _u * 1024 * 100 / _size ))
            [ "$_pct" -gt 100 ] && _pct=100
            _rows="$_rows$_pct|/dev/$_name|$(idiv1 $(( _u * 1024 )) 1073741824)|$(idiv1 "$_size" 1073741824)
"
        done <<EOFD
$_disks
EOFD
    else
        # Portable fallback: group partitions by whole-disk base name (df only).
        _bases=""
        while read -r _dev _tot _rest; do
            [ -n "$_dev" ] || continue
            _b=$(disk_base "$_dev")
            case "|$_bases|" in *"|$_b|"*) ;; *) _bases="$_bases|$_b|" ;; esac
        done < "$dftmp"
        printf '%s\n' "$_bases" | tr '|' '\n' | grep -v '^$' > "$lstmp"
        while IFS= read -r _base; do
            _tot=0 _used=0
            while read -r _dev _t _u _a _c _m; do
                [ "$(disk_base "$_dev")" = "$_base" ] || continue
                _tot=$(( _tot + _t ))
                _used=$(( _used + _u ))
            done < "$dftmp"
            [ "$_tot" -gt 0 ] 2>/dev/null || continue
            _rows="$_rows$(( _used * 100 / _tot ))|$_base|$(idiv1 "$_used" 1048576)|$(idiv1 "$_tot" 1048576)
"
        done < "$lstmp"
    fi

    _n=$(printf '%s\n' "$_rows" | grep -c .)
    while IFS='|' read -r _pct _base _ug _tg; do
        [ -n "$_pct" ] || continue
        if [ "$_n" -gt 1 ]; then _label="  $_base"; else _label=""; fi
        if [ "$use_bar" = 1 ]; then
            disk="$disk$(bar "$_pct" 100 14)${_ug}GiB / ${_tg}GiB (${_pct}%)${_label}
"
        else
            disk="$disk${_ug}GiB / ${_tg}GiB (${_pct}%)${_label}
"
        fi
        d_pct=$_pct
    done <<EOFR
$_rows
EOFR
    disk=$(printf '%s' "$disk")

    rm -f "$dftmp" "$lstmp"
fi

# ---------------------------------------------------------------------------
# IP address
# ---------------------------------------------------------------------------
ip=""
case $platform in
    ios|macos)
        if has ipconfig; then
            iface=$(route -n get default 2>/dev/null | sed -n 's/.*interface: //p' | head -n1)
            [ -z "$iface" ] && iface=en0
            ip=$(ipconfig getifaddr "$iface" 2>/dev/null)
        fi
        ;;
    linux)
        if has ip; then
            # Prefer a wired or wireless NIC; avoid usb-gadget/docker/tailscale.
            _addrs=$(ip -4 -o addr show scope global 2>/dev/null \
                | sed -n 's/^[0-9][0-9]*:[[:space:]]*\([^ ]*\)[[:space:]]*inet \([0-9.]*\).*/\1 \2/p')
            _best="" _bestrank=99
            while read -r _if _a; do
                [ -n "$_if" ] || continue
                case $_if in
                    lo) continue ;;
                    eth*|en*|em*)   _r=1 ;;
                    wlan*|wl*|wls*) _r=2 ;;
                    usb*|docker*|br-*|veth*|tun*|tap*|tailscale*|wwan*|ppp*|virbr*|vmnet*|vnet*|dummy*|zt*) _r=8 ;;
                    *)              _r=5 ;;
                esac
                if [ "$_r" -lt "$_bestrank" ]; then _bestrank=$_r; _best=$_a; fi
            done <<EOFIP
$_addrs
EOFIP
            ip=$_best
        fi
        ;;
esac

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
emit_info() {
printf '%s%s%s%s@%s%s%s\n' \
    "$C_TITLE1" "$user" "$RESET" "$C_TITLE2" "$machine" "$RESET" ""
title="$user@$machine"
# separator line
sep=$(printf '%*s' "${#title}" '' | sed 's/ /─/g')
printf '%s%s%s\n' "$C_DIM" "$sep" "$RESET"

os_line="$os_name"
[ -n "$os_ver" ] && os_line="$os_line $os_ver"
[ -n "$os_build" ] && os_line="$os_line ($os_build)"
[ -n "$arch" ] && os_line="$os_line $arch"
field "OS" "$os_line"

host_line="$host"
[ -n "$host_line" ] && field "Host" "$host_line"

field "Kernel" "$kernel_ver"
[ -n "$uptime_str" ] && field "Uptime" "$uptime_str"
[ -n "$packages" ] && field "Packages" "$packages"
[ -n "$shell" ] && field "Shell" "$shell"
field "Terminal" "$terminal"

[ -n "$cpu" ] && field "CPU" "$cpu"
[ -n "$gpu" ] && field "GPU" "$gpu"

if [ -n "$mem_total" ]; then
    if [ "$use_bar" = 1 ] && [ -n "$mem_used" ]; then
        mb=$(bar "$mem_used" "$mem_total" 14)
        field "Memory" "${mb}${mem_used}MiB / ${mem_total}MiB"
    else
        field "Memory" "${mem_used}MiB / ${mem_total}MiB"
    fi
fi

if [ -n "$battery" ]; then
    if [ "$use_bar" = 1 ] && [ -n "$bat_pct" ]; then
        bb=$(bar "$bat_pct" 100 14)
        field "Battery" "${bb}${battery}"
    else
        field "Battery" "$battery"
    fi
fi

if [ -n "$disk" ]; then
    _n=0
    printf '%s\n' "$disk" | while IFS= read -r _dl; do
        if [ "$_n" = 0 ]; then
            field "Disk" "$_dl"
        else
            printf '%*s%s\n' 10 '' "$_dl"
        fi
        _n=$(( _n + 1 ))
    done
fi

[ -n "$ip" ] && field "Local IP" "$ip"
}

# ---------------------------------------------------------------------------
# Side logo (fastfetch style) — art chosen by OS
# ---------------------------------------------------------------------------
_logo_apple=$(cat <<'LOGOAPPLE'
                    c.'
                 ,xNMM.
               .OMMMMo
               lMMM"
     .;loddo:.  .olloddol;.
   cKMMMMMMMMMMNWMMMMMMMMMM0:
 .KMMMMMMMMMMMMMMMMMMMMMMMWd.
 XMMMMMMMMMMMMMMMMMMMMMMMX.
;MMMMMMMMMMMMMMMMMMMMMMMM:
:MMMMMMMMMMMMMMMMMMMMMMMM:
.MMMMMMMMMMMMMMMMMMMMMMMMX.
 kMMMMMMMMMMMMMMMMMMMMMMMMWd.
 'XMMMMMMMMMMMMMMMMMMMMMMMMMMk
  'XMMMMMMMMMMMMMMMMMMMMMMMMK.
    kMMMMMMMMMMMMMMMMMMMMMMd
     ;KMMMMMMMWXXWMMMMMMMk.
       "cooc*"    "*coo'
LOGOAPPLE
)

_logo_tux=$(cat <<'LOGOTUX'
       .--.
      |o_o |
      |:_/ |
     //   \ \
    (|     | )
   /'\_   _/`\
   \___)=(___/
LOGOTUX
)

_logo_generic=$(cat <<'LOGOGEN'
    .--------.
    |  >_    |
    |        |
    '--------'
LOGOGEN
)

case $platform in
    ios|macos) logo_art=$_logo_apple;   logo_color="${E}[1;32m" ;;
    linux)     logo_art=$_logo_tux;     logo_color="${E}[1m" ;;
    *)         logo_art=$_logo_generic; logo_color="${E}[1m" ;;
esac

# Resolve auto logo setting.
if [ -z "$use_logo" ]; then
    if [ "$use_color" = 1 ] && [ -t 1 ]; then
        cols=$(tput cols 2>/dev/null)
        [ -z "$cols" ] && cols=80
        [ "$cols" -ge 74 ] 2>/dev/null && use_logo=1 || use_logo=0
    else
        use_logo=0
    fi
fi

if [ "$use_logo" = 1 ] && has mktemp; then
    logof=$(mktemp "${TMPDIR:-/tmp}/minifetch.logo.XXXXXX")
    infof=$(mktemp "${TMPDIR:-/tmp}/minifetch.info.XXXXXX")
fi

if [ -n "$infof" ]; then
    emit_info > "$infof"
    printf '%s\n' "$logo_art" > "$logof"

    # widest visible logo line
    logow=0
    IFS='
'
    for l in $logo_art; do
        n=${#l}
        [ "$n" -gt "$logow" ] && logow=$n
    done
    unset IFS

    exec 3<"$logof"
    exec 4<"$infof"
    while IFS= read -r l <&3; do
        if IFS= read -r i <&4; then :; else i=; fi
        printf '%s%s%s' "$logo_color" "$l" "$RESET"
        printf '%*s' $(( logow - ${#l} + 2 )) ''
        printf '%s\n' "$i"
    done
    while IFS= read -r i <&4; do
        printf '%*s  %s\n' $(( logow + 2 )) '' "$i"
    done
    exec 3<&-
    exec 4<&-
    rm -f "$logof" "$infof"
else
    emit_info
fi
